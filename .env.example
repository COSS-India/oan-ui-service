# Maintenance Mode
# Set to 'true' to enable maintenance mode and show the maintenance page
# Set to 'false' or remove to disable maintenance mode
VITE_MAINTENANCE_MODE=true

# Iframe embed: extra comma-separated parent origins (defaults include vistaar.maharashtra.gov.in)
# VITE_ALLOWED_PARENT_ORIGINS=http://localhost:3000

# Milliseconds to wait for parent postMessage token when no ?token= or stored JWT (default 15000)
# VITE_EMBED_AUTH_TIMEOUT_MS=15000
