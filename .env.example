# Backend API base URL. The UI targets this host for /api/token, /api/chat, etc.
# Defaults to the MahaPocra prod URL when unset.
VITE_API_BASE_URL=https://your-backend.example

# JWT public key used to verify the auth token. Must match the backend's
# jwt_public_key.pem for the target environment. Newlines may be encoded as \n.
# Falls back to the bundled mh-oan-api key when unset.
VITE_JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Sub-path the app is served under on the platform (e.g. /oan).
# VITE_BASE (asset base, must end with /) and VITE_ROUTER_BASEPATH (router basename)
# must stay in sync. Defaults: /oan/ and /oan. Set both to / to run at root.
VITE_BASE=/oan/
VITE_ROUTER_BASEPATH=/oan

# Sunbird telemetry. Set VITE_TELEMETRY_ENABLED=false to disable where the
# observability-service route is not provisioned. VITE_TELEMETRY_HOST overrides
# the default "/observability-service" host.
VITE_TELEMETRY_ENABLED=true
VITE_TELEMETRY_HOST=/observability-service

# Maintenance Mode
# Set to 'true' to enable maintenance mode and show the maintenance page
# Set to 'false' or remove to disable maintenance mode
VITE_MAINTENANCE_MODE=false
